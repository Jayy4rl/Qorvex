# Copy to .env at the repository root (git-ignored). Nothing here is required for `npm run demo`.
# Relative paths below are relative to the repository root.

# --- Service
PORT=8787
# PUBLIC_URL=https://qorvex.example.org      # used in alert links
# QORVEX_ADMIN_TOKEN=                        # operator console/API token (>= 16 chars, e.g. `openssl rand -hex 16`); generated per run if empty
# QORVEX_NETWORKS=mainnet,testnet            # networks to watch with `npm start` (mainnet, testnet, sandbox)
# QORVEX_DATA_DIR=data                       # stores, caches and keys (git-ignored)

# --- NEAR AI Cloud (rule drafting + breach explanations)
# QORVEX_AI_MODE=replay                      # replay (committed fixtures, no key) | live | record
# NEARAI_API_KEY=                            # from https://cloud.near.ai
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# QORVEX_DRAFT_MODEL=qwen/qwen3.5-397b-a17b
# QORVEX_EXPLAIN_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# QORVEX_FALLBACK_MODELS=qwen/qwen3.5-397b-a17b,z-ai/glm-5.3   # tried in order when the primary model fails
# QORVEX_AI_THINKING=off                     # on: let Qwen3 models reason before answering
# QORVEX_AI_FIXTURES=backend/fixtures/ai     # where replay/record fixtures live

# --- Alerts (D5)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# QORVEX_WEBHOOK_URL=
# QORVEX_WEBHOOK_SECRET=                     # HMAC-SHA256 in the x-qorvex-signature header

# --- Block stream (NEAR Data API by FastNEAR). Optional key for higher rate limits.
# FASTNEAR_API_KEY=

# --- Per network (NET = TESTNET | MAINNET | SANDBOX)
# QORVEX_TESTNET_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs
# QORVEX_TESTNET_ARCHIVAL_RPC=https://archival-rpc.testnet.near.org
# QORVEX_TESTNET_GUARDIAN=guardian.you.testnet
# QORVEX_TESTNET_WATCHER_ACCOUNT=watcher.you.testnet
# QORVEX_TESTNET_WATCHER_KEY=ed25519:...     # function-call key: receiver = guardian, methods = ["pause"]
# QORVEX_TESTNET_FIREWALL_ACCOUNT=firewall.you.testnet   # proposal firewall: a reject-only member of protected DAOs
# QORVEX_TESTNET_FIREWALL_KEYS={"dao.sputnik-dao.testnet":"ed25519:..."}  # one function-call key per DAO, act_proposal only
# QORVEX_TESTNET_STREAM=neardata             # or rpc
# QORVEX_MAINNET_BACKTEST_DAYS=30
# QORVEX_MAINNET_BACKTEST_SAMPLES=30
# QORVEX_MAINNET_ARCHIVAL_RPC=https://archival-rpc.mainnet.near.org  # set a paid endpoint: the public one rate-limits

# --- Testnet deployment of the demo world (backend/scripts/deploy-testnet.ts)
# TESTNET_ACCOUNT_ID=you.testnet
# TESTNET_PRIVATE_KEY=ed25519:...

# --- Relayer SDK (in your relayer process)
# QORVEX_RELAYER_TOKEN=

# --- Scripts and development
# QORVEX_URL=http://localhost:8787           # server the seed:intents script talks to
# QORVEX_DEMO_DIR=data/demo                  # where `npm run demo` keeps its store, sandbox keys and summary
# QORVEX_DEMO_MAINNET=1                      # demo also watches mainnet next to the sandbox
# QORVEX_SKIP_WEB_BUILD=1                    # `npm start` / `npm run demo` skip the frontend freshness check
# QORVEX_API=http://localhost:8787           # API the Vite dev server (`npm run dev:web`) proxies to
