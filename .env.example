# Copy to .env (git-ignored). Nothing here is required for `npm run demo`.

# --- Service
PORT=8787
# PUBLIC_URL=https://qorvex.example.org      # used in alert links
# QORVEX_ADMIN_TOKEN=                        # operator console/API token; generated per run if empty
# QORVEX_NETWORKS=mainnet,testnet            # networks to watch with `npm start`
# QORVEX_DATA_DIR=data

# --- NEAR AI Cloud (rule drafting + breach explanations)
# QORVEX_AI_MODE=replay                      # replay (committed fixtures, no key) | live | record
# NEARAI_API_KEY=                            # from https://cloud.near.ai
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# QORVEX_DRAFT_MODEL=qwen/qwen3.5-397b-a17b
# QORVEX_EXPLAIN_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# --- Alerts (D5)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# QORVEX_WEBHOOK_URL=
# QORVEX_WEBHOOK_SECRET=                     # HMAC-SHA256 in the x-qorvex-signature header

# --- Block stream (NEAR Data API by FastNEAR). Optional key for higher rate limits.
# FASTNEAR_API_KEY=
# QORVEX_TESTNET_STREAM=rpc                  # follow blocks over RPC instead of neardata.xyz

# --- Per network (NET = TESTNET | MAINNET | SANDBOX)
# QORVEX_TESTNET_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs
# QORVEX_TESTNET_ARCHIVAL_RPC=https://archival-rpc.testnet.near.org
# QORVEX_TESTNET_GUARDIAN=guardian.you.testnet
# QORVEX_TESTNET_WATCHER_ACCOUNT=watcher.you.testnet
# QORVEX_TESTNET_WATCHER_KEY=ed25519:...     # function-call key: receiver = guardian, methods = ["pause"]
# QORVEX_MAINNET_BACKTEST_DAYS=30
# QORVEX_MAINNET_BACKTEST_SAMPLES=30

# --- Testnet deployment of the demo world (scripts/deploy-testnet.ts)
# TESTNET_ACCOUNT_ID=you.testnet
# TESTNET_PRIVATE_KEY=ed25519:...

# --- Relayer SDK (in your relayer process)
# QORVEX_RELAYER_TOKEN=
