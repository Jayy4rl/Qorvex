{
  "name": "qorvex",
  "version": "0.1.0",
  "private": true,
  "description": "Spending limits and circuit breakers for NEAR contracts, DAO treasuries and gas relayers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "sdk",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node frontend/scripts/ensure-built.mjs && npm run start -w @qorvex/backend --",
    "demo": "node frontend/scripts/ensure-built.mjs && npm run demo -w @qorvex/backend --",
    "dev:web": "npm run dev -w @qorvex/frontend",
    "build:web": "npm run build -w @qorvex/frontend",
    "build:contracts": "bash contracts/build.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @qorvex/backend",
    "test:unit": "npm run test:unit -w @qorvex/backend",
    "test:e2e": "npm run test:e2e -w @qorvex/backend",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "check": "npm run typecheck && npm run test:unit && npm run test:web && npm run build:web",
    "seed:intents": "npm run seed:intents -w @qorvex/backend --",
    "deploy:testnet": "npm run deploy:testnet -w @qorvex/backend --",
    "firewall:replay": "npm run firewall:replay -w @qorvex/backend --",
    "test:web": "npm test -w @qorvex/frontend",
    "replay:testnet": "npm run replay:testnet -w @qorvex/backend --",
    "finish:testnet": "npm run finish:testnet -w @qorvex/backend --"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
